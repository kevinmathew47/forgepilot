+@click.command("config", short_help="Show the app config.")
+@with_appcontext
+def config_command() -> None:
+    """Show the app config as JSON, masking secret keys."""
+    def _mask_value(key: str, value: t.Any) -> t.Any:
+        if any(token in key for token in ("SECRET", "PASSWORD", "TOKEN", "KEY")):
+            return "***"
+        if isinstance(value, dict):
+            return {k: _mask_value(str(k), v) for k, v in value.items()}
+        if isinstance(value, list):
+            return [_mask_value(key, v) for v in value]
+        if isinstance(value, tuple):
+            return tuple(_mask_value(key, v) for v in value)
+        return value
+
+    cfg = {}
+    for key in sorted(current_app.config.keys(), key=str):
+        val = current_app.config[key]
+        try:
+            current_app.json.dumps(val)
+        except (TypeError, ValueError):
+            val = str(val)
+        cfg[key] = _mask_value(key, val)
+
+    click.echo(dumps(cfg, indent=2))
+
+
